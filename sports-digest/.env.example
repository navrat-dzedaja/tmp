# Copy to .env and fill in.

# --- LLM backend ---
LLM_PROVIDER=anthropic          # anthropic | ollama

# anthropic backend
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ollama backend (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# --- football-data.org ---
FOOTBALL_DATA_API_TOKEN=your-football-data-token

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- App config ---
CONFIG_PATH=config.yaml
# DIGEST_CRON overrides the digest_cron value in config.yaml if set, e.g.:
# DIGEST_CRON=0 8 * * *
