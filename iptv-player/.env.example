# Zkopíruj jako `.env` (docker compose ho načte sám) a uprav.
# Po změně: docker compose up -d

# ── Playlisty ──────────────────────────────────────────────────────────────
# Pro každý playlist trojice PLAYLIST_<n>_URL / _NAME / _GROUPS (n = 1..30).
# _GROUPS je nepovinné. Když ho vynecháš, zobrazí se všechny skupiny.
#   Sport            přesný název skupiny (nezáleží na velikosti písmen)
#   Nova*            hvězdička zastupuje libovolný text
#   !18+             vykřičník skupinu vyloučí
# Názvy skupin uvidíš v aplikaci jako štítky nad seznamem kanálů.

PLAYLIST_1_NAME=BCU Media
PLAYLIST_1_URL=https://bcumedia.su/playlist/hls/ucbaaspl8i.m3u
#PLAYLIST_1_GROUPS=Sport*, Czech*, !18+

#PLAYLIST_2_NAME=Druhy zdroj
#PLAYLIST_2_URL=http://neco/playlist.m3u
#PLAYLIST_2_GROUPS=Film*, Dokument*

# ── EPG (XMLTV) ────────────────────────────────────────────────────────────
# EPG_<n>_URL, n = 1..30. Podporuje i gzipované .xml.gz.

EPG_1_URL=https://epg.bcumedia.pro/epg.xml

# ── Vzhled ─────────────────────────────────────────────────────────────────
# Jak se má jmenovat kategorie oblíbených kanálů.

#FAVORITES_NAME=Moje oblíbené

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────
# Vystaví přehrávač na https://tv.toobab.net bez otevírání portů na routeru.
#
# 1) https://one.dash.cloudflare.com -> Networks -> Tunnels -> Create a tunnel
# 2) typ "Cloudflared", pojmenuj (třeba "tivi"), zkopíruj token z instalačního
#    příkazu (dlouhý řetězec za `--token`) a vlož ho níže
# 3) v tunelu Public Hostname -> Add:
#       Subdomain: tv     Domain: toobab.net
#       Service:   HTTP   URL: tivi-web:8098
#    (`tivi-web` je název služby v docker-compose, DNS záznam vytvoří Cloudflare)
# 4) odkomentuj obě proměnné níže a spusť `docker compose up -d`

#COMPOSE_PROFILES=tunnel
#CLOUDFLARE_TUNNEL_TOKEN=sem_vloz_token_z_dashboardu

# ── Server ─────────────────────────────────────────────────────────────────

#PORT=8098
#UPSTREAM_UA=VLC/3.0.20 LibVLC/3.0.20

# Server odmítá stahovat z adres ve tvé lokální síti — jinak by z něj po
# vystavení na internet byla otevřená proxy do domácí sítě. Povol jen pokud máš
# playlist nebo EPG na privátní adrese (a pak ideálně bez veřejného tunelu).
#ALLOW_PRIVATE_UPSTREAM=true
