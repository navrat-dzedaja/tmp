# Zkopíruj jako `.env` (docker compose ho načte sám) a uprav.
# Po změně: docker compose up -d

# ── Playlisty ──────────────────────────────────────────────────────────────
# Pro každý playlist trojice PLAYLIST_<n>_URL / _NAME / _GROUPS (n = 1..30).
# _GROUPS je nepovinné. Když ho vynecháš, zobrazí se všechny skupiny.
#   Sport            přesný název skupiny (nezáleží na velikosti písmen)
#   Nova*            hvězdička zastupuje libovolný text
#   !18+             vykřičník skupinu vyloučí
# Názvy skupin uvidíš v aplikaci jako štítky nad seznamem kanálů.

PLAYLIST_1_NAME=BCU Media
PLAYLIST_1_URL=https://bcumedia.su/playlist/hls/ucbaaspl8i.m3u
#PLAYLIST_1_GROUPS=Sport*, Czech*, !18+

#PLAYLIST_2_NAME=Druhy zdroj
#PLAYLIST_2_URL=http://neco/playlist.m3u
#PLAYLIST_2_GROUPS=Film*, Dokument*

# ── EPG (XMLTV) ────────────────────────────────────────────────────────────
# EPG_<n>_URL, n = 1..30. Podporuje i gzipované .xml.gz.

EPG_1_URL=https://epg.bcumedia.pro/epg.xml

# ── Vzhled ─────────────────────────────────────────────────────────────────
# Jak se má jmenovat kategorie oblíbených kanálů.

#FAVORITES_NAME=Moje oblíbené

# ── Server ─────────────────────────────────────────────────────────────────

#PORT=8098
#UPSTREAM_UA=VLC/3.0.20 LibVLC/3.0.20
